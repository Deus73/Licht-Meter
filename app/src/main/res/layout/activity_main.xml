<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:contentDescription="@string/logo_description"
                android:scaleType="centerCrop"
                android:src="@drawable/light_meter_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.12"
                    android:text="@string/eyebrow"
                    android:textColor="@color/moss"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/screen_title"
                    android:textColor="@color/ink"
                    android:textSize="34sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/settings_button_background"
                android:contentDescription="@string/open_settings"
                android:padding="12dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/white" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/metric_background">

            <TextureView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.72" />

            <View
                android:id="@+id/meterTarget"
                android:layout_width="118dp"
                android:layout_height="118dp"
                android:layout_gravity="center"
                android:background="@drawable/meter_target" />

            <FrameLayout
                android:id="@+id/sourceVisual"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/source_visual_background"
                android:contentDescription="@string/light_intensity_visual">

                <View
                    android:id="@+id/sourceGlow"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_gravity="top|center_horizontal" />

                <ImageView
                    android:id="@+id/sourceVisualImage"
                    android:layout_width="138dp"
                    android:layout_height="138dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/light_intensity_bulb" />

                <LinearLayout
                    android:id="@+id/lampTypeButtons"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/whiteLedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/source_button_background"
                        android:contentDescription="@string/source_white_led"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/source_white_led" />

                    <ImageButton
                        android:id="@+id/blurpleLedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/source_button_background"
                        android:contentDescription="@string/source_blurple_led"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/source_blurple_led" />

                    <ImageButton
                        android:id="@+id/sunlightButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/source_button_background"
                        android:contentDescription="@string/source_sunlight"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/source_sunlight" />

                    <ImageButton
                        android:id="@+id/hpsButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/source_button_background"
                        android:contentDescription="@string/source_hps"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/source_hps" />

                    <ImageButton
                        android:id="@+id/fluorescentButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/source_button_background"
                        android:contentDescription="@string/source_fluorescent"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/source_fluorescent" />
                </LinearLayout>
            </FrameLayout>

            <Button
                android:id="@+id/previewToggleButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="end|top"
                android:layout_margin="12dp"
                android:backgroundTint="#CC06130D"
                android:text="@string/show_camera"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_margin="14dp"
                android:background="#CC10221A"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="@string/camera_starting"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/metric_background"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_illuminance"
                    android:textColor="@color/lime"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/luxValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/empty_lux"
                    android:textColor="@color/white"
                    android:textSize="27sp" />
                <TextView
                    android:id="@+id/fcValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_fc"
                    android:textColor="#CDE1D5"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_grow_light"
                    android:textColor="@color/lime"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/ppfdValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/empty_ppfd"
                    android:textColor="@color/white"
                    android:textSize="27sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ppfd_unit"
                    android:textColor="#CDE1D5"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/stabilityValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="@string/measurement_settling"
                android:textColor="@color/moss"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/rangeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/range_empty"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dliValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/dli_empty"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="@string/assessment_heading"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/assessmentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/assessment_too_low"
                android:textColor="@color/moss"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/assessmentDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/assessment_too_low_detail"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/lightGuideButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/button_background"
            android:text="@string/open_light_guide"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/advancedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/moss"
            android:text="@string/advanced_button"
            android:textColor="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="@string/history_title"
                android:textColor="@color/ink"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/clearHistoryButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/button_background"
                android:text="@string/clear_history"
                android:textColor="@color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/measurement_help"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
