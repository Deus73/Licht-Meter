<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/camera_label"
            android:textColor="@color/muted"
            android:textSize="12sp" />
        <Spinner
            android:id="@+id/cameraSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/cameraProfileText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/moss"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/preset_label"
            android:textColor="@color/muted"
            android:textSize="12sp" />
        <Spinner
            android:id="@+id/presetSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/area_label"
            android:textColor="@color/muted"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/areaInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/area_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:singleLine="true" />
        <TextView
            android:id="@+id/lumenValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/lumen_empty"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/photoperiod_label"
            android:textColor="@color/muted"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/photoperiodInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/photoperiod_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/calibration_label"
            android:textColor="@color/muted"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/calibrationInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/calibration_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/lamp_name_label"
            android:textColor="@color/muted"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/lampNameInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/lamp_name_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:singleLine="true" />

        <Button
            android:id="@+id/saveMeasurementButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/button_background"
            android:text="@string/save_measurement"
            android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
